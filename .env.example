# The application does not require secrets or user-supplied runtime variables.
# Coolify manages SERVICE_FQDN_APP_3000 from docker-compose.yml and routes it
# to the app's exposed internal port 3000.
#
# DATA_FILE_PATH, HOSTNAME, PORT, and NODE_ENV are fixed in docker-compose.yml
# because changing them would break the image, healthcheck, or persistent volume.
