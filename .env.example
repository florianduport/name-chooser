# Google Cloud OAuth 2.0 Web application credentials (required).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Generate with: openssl rand -base64 32
AUTH_SECRET=

# Public HTTPS origin. Do not include the callback path here.
AUTH_URL=https://name-chooser.54.36.101.144.sslip.io

# Local Compose database credential. Coolify can generate this from the
# SERVICE_PASSWORD_POSTGRES convention.
SERVICE_PASSWORD_POSTGRES=replace-with-a-long-random-password

# Optional overrides. Compose derives DATABASE_URL from the Postgres service.
# DATABASE_URL=postgresql://namechooser:password@db:5432/namechooser
# DATABASE_SSL=false

# Optional Web Push. Generate a VAPID pair with:
# npx web-push generate-vapid-keys
# Leave all three empty to disable push while keeping in-app notifications.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Optional PostHog analytics. The client is disabled when the key is empty and
# does not load until the visitor accepts optional cookies.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Optional ads. Disabled by default. Scripts load only after cookie consent.
ADS_ENABLED=false
ADSENSE_CLIENT_ID=
ADSENSE_SLOT_BETWEEN_ROUNDS=
ADSENSE_SLOT_BEFORE_RESULT=

# Optional affiliate destinations. Use {name} where the URL should receive the
# selected name. Empty values render clearly marked non-clickable placeholders.
NEXT_PUBLIC_AFFILIATE_BIRTH_ANNOUNCEMENTS_URL=
NEXT_PUBLIC_AFFILIATE_JEWELRY_URL=
NEXT_PUBLIC_AFFILIATE_BODYSUITS_URL=
NEXT_PUBLIC_AFFILIATE_MUGS_URL=
NEXT_PUBLIC_AFFILIATE_POSTERS_URL=

# Google authorized redirect URI:
# https://name-chooser.54.36.101.144.sslip.io/api/auth/callback/google
